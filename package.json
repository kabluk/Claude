{
  "name": "accessatlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AccessAtlas — directory of verified digital-accessibility audit agencies (EAA / WCAG / ADA / BFSG / RGAA).",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/build-a11y.mjs",
    "build": "node scripts/build-a11y.mjs && vite-react-ssg build && node scripts/gen-a11y-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "merge": "node scripts/merge-a11y.mjs",
    "enrich": "node scripts/enrich-a11y.mjs",
    "check-links": "node scripts/check-links.mjs",
    "audit-a11y": "node scripts/audit-own-a11y.mjs",
    "worker:test": "node --test worker/**/*.test.mjs",
    "scripts:test": "node --test scripts/**/*.test.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply accessatlas-scans --local",
    "db:migrate:remote": "wrangler d1 migrations apply accessatlas-scans --remote"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.119.0"
  }
}
