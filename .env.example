# Скопируйте в .env.local (не коммитится) для локальной разработки сканера.
# В проде — переменная сборки Cloudflare Pages, задаётся в настройках проекта.

# Origin задеплоенного Worker'а (worker/, wrangler.jsonc), без завершающего слэша.
# Пример: https://accessatlas-worker.<account>.workers.dev
VITE_SCANNER_API=

# Публичный site key Cloudflare Turnstile (Dashboard -> Turnstile -> Add site).
# Не секрет. Парный TURNSTILE_SECRET_KEY живёт только в Worker secrets, не здесь.
VITE_TURNSTILE_SITE_KEY=
