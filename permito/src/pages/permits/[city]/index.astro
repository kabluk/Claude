---
import Base from '../../../layouts/Base.astro';
import { loadCopy, loadCities, cityStats, TRADES, fmtMoney, fmtDate, fill } from '../../../lib/data.mjs';

export function getStaticPaths() {
  return loadCities().map((city) => ({ params: { city: city.city }, props: { city } }));
}

const { city } = Astro.props;
const copy = loadCopy();
const s = cityStats(city);
const tradeMap = Object.fromEntries(TRADES.map((t) => [t.slug, t]));
const tradeRows = TRADES.map((t) => ({ trade: t, count: s.byTrade[t.slug] }))
  .filter((r) => r.count > 0)
  .sort((a, b) => b.count - a.count);
const recent = city.permits.slice(0, 50);

const title = fill(copy.cityPage.titleTemplate, { city: city.cityName });
const intro = fill(copy.cityPage.introTemplate, {
  city: city.cityName,
  state: city.stateName,
  count: s.total.toLocaleString('en-US'),
  days: '90',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${city.cityName}, ${city.state} building permits`,
  description: intro,
  isBasedOn: city.source.url,
  creator: { '@type': 'Organization', name: copy.brand.name },
  spatialCoverage: `${city.cityName}, ${city.state}`,
};
---

<Base title={title} description={intro} schema={schema}>
  <div class="wrap"><p class="crumbs"><a href="/">Home</a> › <a href="/permits/">Cities</a> › {city.cityName}</p></div>

  <section style="padding-top:20px">
    <div class="wrap">
      <h1 class="sec" style="font-size:32px">{city.cityName}, {city.state} building permits</h1>
      <p class="sec-sub">{intro}</p>
      <div class="hero-stats" style="margin:0 0 10px">
        <div class="stat"><b>{s.total.toLocaleString('en-US')}</b><span>permits · last 90 days</span></div>
        <div class="stat"><b>{s.last30.toLocaleString('en-US')}</b><span>last 30 days</span></div>
        <div class="stat"><b>{fmtMoney(s.totalValuation)}</b><span>reported construction value</span></div>
        <div class="stat"><b>{fmtMoney(s.medianValuation)}</b><span>median job value</span></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2 class="sec">Permits by trade</h2>
      <p class="sec-sub">{fill(copy.cityPage.leadCtaTemplate, { city: city.cityName })}</p>
      <div class="grid c4">
        {tradeRows.map(({ trade, count }) => (
          <a class="card link-card" href={count >= 3 ? `/leads/${trade.slug}/${city.city}/` : `/leads/${trade.slug}/`}>
            <h3>{trade.name}</h3>
            <p>{count.toLocaleString('en-US')} permits · 90 days</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="sec">Latest permits</h2>
      <p class="sec-sub">The 50 most recent permits issued in {city.cityName}. Full feed with contacts and daily alerts is part of the <a href="/#pricing">lead plans</a>.</p>
      <div class="tbl-scroll">
        <table>
          <thead>
            <tr><th>Issued</th><th>Address</th><th>Work</th><th>Trades</th><th class="num">Value</th></tr>
          </thead>
          <tbody>
            {recent.map((p) => (
              <tr>
                <td style="white-space:nowrap">{fmtDate(p.issuedDate)}</td>
                <td>{p.address || '—'}</td>
                <td><div class="desc-cell" title={p.description || p.type}>{p.description || p.type || '—'}</div></td>
                <td>{p.trades.map((t) => <span class="tag">{tradeMap[t]?.name || t}</span>)}</td>
                <td class="num">{fmtMoney(p.valuation)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {s.topContractors.length > 0 && (
    <section class="alt">
      <div class="wrap">
        <h2 class="sec">Most active contractors</h2>
        <p class="sec-sub">Ranked by permit count over the last 90 days in {city.cityName}.</p>
        <div class="tbl-scroll" style="max-width:640px">
          <table>
            <thead><tr><th>Contractor</th><th class="num">Permits</th></tr></thead>
            <tbody>
              {s.topContractors.map((c) => (
                <tr><td>{c.name}</td><td class="num">{c.count}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="card" style="max-width:640px">
        <h3>Get {city.cityName} permits as a lead feed</h3>
        <p>Daily email with new permits matching your trade and area — addresses, work descriptions, and values included.</p>
        <form class="waitlist" data-plan={`city-${city.city}`} style="margin-top:14px">
          <input type="email" required placeholder="Work email" aria-label="Work email" />
          <button class="btn" type="submit">Join the waitlist</button>
          <span class="done">You're on the list — we'll be in touch.</span>
        </form>
      </div>
      <p class="crumbs">Source: <a href={city.source.portal} rel="nofollow">{city.source.name}</a> · snapshot {fmtDate((city.fetchedAt || '').slice(0, 10))}</p>
    </div>
  </section>
</Base>
