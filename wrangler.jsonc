{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accessatlas-worker",
  "main": "worker/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Реальные ресурсы созданы 2026-08-06 на аккаунте владельца (D-010 закрыт).
  // Секреты НЕ сюда — `npx wrangler secret put TURNSTILE_SECRET_KEY` /
  // `npx wrangler secret put ANTHROPIC_API_KEY` (последний нужен только для
  // A1-EXPLAIN — без него /api/explain отвечает 503, остальной сайт работает).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accessatlas-scans",
      "database_id": "ff550a44-5ca8-4cc4-9c1e-51b714c6a754",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "99832c9f43c24f76bd28b0bd4ca08cd3" },
    { "binding": "EXPLAIN_CACHE", "id": "d9762377e6114656a32dad4996b9a564" }
  ],
  "browser": { "binding": "BROWSER" },
  // D-110: скан больше НЕ живёт в ctx.waitUntil — у waitUntil жёсткий потолок
  // 30с после отправки ответа (платформа отменяет промис молча, вместе со
  // сторожем D-108 и его catch). Очередь `accessatlas-scan-queue` создана
  // 2026-08-10; consumer-инвокация живёт до 15 минут wall-clock, поэтому сторож
  // D-108 (120с) наконец может реально дорабатывать и писать failScan.
  "queues": {
    // Producer: POST /api/scan кладёт джоб и отвечает 202 — биндинг обязателен,
    // без него роут отвечает 503 (см. worker/routes/scan.js, осознанно НЕ
    // откатываемся на waitUntil: тихий откат вернул бы ровно тот баг, ради
    // которого всё это сделано).
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "accessatlas-scan-queue" }],
    "consumers": [
      {
        "queue": "accessatlas-scan-queue",
        // 1 сообщение на инвокацию: один скан = один браузер Browser Rendering
        // (платный, тяжёлый, до 120с). Батч из нескольких сканов складывал бы
        // их время в одну инвокацию и упирался бы в лимит инвокации.
        "max_batch_size": 1,
        // При batch_size=1 батч «полон» сразу — таймаут почти никогда не
        // применяется; держим маленьким, чтобы одинокое сообщение не ждало.
        "max_batch_timeout": 5,
        // 2 повтора. Обработчик сам делает ack и на успехе, и на ошибке скана
        // (исход уже записан в D1 — пересканировать нечего). Повтор остаётся
        // только для случая «исход НЕ записан»: D1 недоступен или инвокацию
        // убило посреди скана. Больше двух — это оплаченные Browser
        // Rendering-прогоны по сайту, который, скорее всего, и так не даётся;
        // после исчерпания сообщение отбрасывается (dead-letter очереди нет),
        // и строку в `running` закроет второй рубеж D-109 при первом же GET.
        // A1-SCAN-BUSY-RETRY: это число ДУБЛИРУЕТСЯ в коде —
        // worker/lib/scanJob.js::MAX_DELIVERIES = 1 + max_retries (msg.attempts
        // считает доставки и начинается с 1). Менять только парой: за дрейфом
        // следит гейт-тест в worker/lib/scanJob.test.mjs, он покраснеет.
        "max_retries": 2,
        // Потолок параллельных консьюмеров: Browser Rendering ограничивает
        // число одновременных сессий на аккаунт, и упереться в этот лимит —
        // значит получить пачку сканов с ошибкой запуска браузера вместо
        // очереди, которая просто подождёт.
        "max_concurrency": 2
      }
    ]
  },
  // Один ежедневный тик, две задачи в worker/index.js::scheduled:
  //   1) зачистка scans старше worker/lib/retention.js::RETENTION_DAYS (D-019);
  //   2) A3-CRON-RESCAN-DELTA (D-135): постановка недельных ре-сканов подписок
  //      в SCAN_QUEUE (worker/lib/subscriptionCron.js).
  // Второго cron-элемента НЕТ намеренно: недельная периодичность держится
  // фильтром по каждой подписке (7 дней от её собственного последнего скана), а
  // не расписанием. Отдельный `0 3 * * 1` сканировал бы всех подписчиков одним
  // залпом по понедельникам — при max_concurrency=2 у очереди это очередь на
  // часы и задержка до 6 дней у только что подписавшегося.
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    // Дублирует ORIGIN из src/lib/seo.tsx / scripts/gen-a11y-sitemap.mjs — боевой
    // домен (A0-ORIGIN, куплен 2026-08-08); держать в синхроне, иначе CORS у
    // /api/scan будет закрыт. Также база всех ссылок в письмах, ведущих на САЙТ
    // (confirm/unsubscribe-страницы, /report/:id — A3-CRON-MONITORING-PAGES, D-139).
    "ALLOWED_ORIGIN": "https://verscala.com",
    // A3-CRON-MONITORING-PAGES (D-139): публичный origin САМОГО воркера. Нужен
    // ТОЛЬКО машинному заголовку List-Unsubscribe дайджеста (RFC 8058 one-click
    // POST шлётся прямо на воркер, минуя сайт). У cron нет request, origin воркера
    // взять неоткуда — берётся отсюда (fallback-константа в subscriptionCron.js,
    // если var пуст). Значение — реальный адрес деплоя (D-138), совпадает с
    // VITE_SCANNER_API сайта.
    "WORKER_ORIGIN": "https://accessatlas-worker.zincroom.workers.dev"
  }
}
