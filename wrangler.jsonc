{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accessatlas-worker",
  "main": "worker/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Реальные ресурсы созданы 2026-08-06 на аккаунте владельца (D-010 закрыт).
  // Секреты НЕ сюда — `npx wrangler secret put TURNSTILE_SECRET_KEY` /
  // `npx wrangler secret put ANTHROPIC_API_KEY` (последний нужен только для
  // A1-EXPLAIN — без него /api/explain отвечает 503, остальной сайт работает).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accessatlas-scans",
      "database_id": "ff550a44-5ca8-4cc4-9c1e-51b714c6a754",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "99832c9f43c24f76bd28b0bd4ca08cd3" },
    { "binding": "EXPLAIN_CACHE", "id": "d9762377e6114656a32dad4996b9a564" }
  ],
  "browser": { "binding": "BROWSER" },
  // Ежедневная зачистка scans старше worker/lib/retention.js::RETENTION_DAYS (D-019).
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    // Дублирует ORIGIN из src/lib/seo.tsx / scripts/gen-a11y-sitemap.mjs — боевой
    // домен (A0-ORIGIN, куплен 2026-08-08); держать в синхроне, иначе CORS у
    // /api/scan будет закрыт.
    "ALLOWED_ORIGIN": "https://verscala.com"
  }
}
