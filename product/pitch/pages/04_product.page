pageType: content
background: {type: solid, color: "$bg"}
elements:
  - elementId: kick
    elementType: text
    bounds: [60, 36, 400, 22]
    content: {style: "$kicker", text: ПРОДУКТ}
  - elementId: h
    elementType: text
    bounds: [60, 62, 840, 44]
