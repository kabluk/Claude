pageType: content
background: {type: solid, color: "$bg"}
elements:
  - elementId: kick
    elementType: text
    bounds: [60, 36, 400, 22]
    content: {style: "$kicker", text: ЮНИТ-ЭКОНОМИКА · БАЗОВЫЙ СЦЕНАРИЙ}
  - elementId: h
    elementType: text
    bounds: [60, 62, 840, 44]
    content: {style: "$h1", text: "Окупаемость на клиенте — с первой же покупки"}
  - elementId: t
    elementType: table
    bounds: [60, 125, 840, 270]
    columnWidths: [0.46, 0.18, 0.18, 0.18]
    rowHeights: [0.16, 0.14, 0.14, 0.14, 0.14, 0.14, 0.14]
    style: "$default"
    rows:
      - - text: "Показатель"
        - text: "Пессимистичный"
        - text: "Базовый"
        - text: "Оптимистичный"
      - - text: "Конверсия лендинг → покупка Kit"
        - text: "1,0%"
        - text: "2,5%"
        - text: "4,0%"
      - - text: "Доля покупающих Monitor"
        - text: "25%"
        - text: "40%"
        - text: "55%"
      - - text: "Средняя жизнь подписки, мес."
        - text: "2"
        - text: "3"
        - text: "4"
      - - text: "Выручка на платного клиента (LTV)"
        - text: "$103"
        - text: "$108,6"
        - text: "$116,6"
      - - text: "CAC (общины + SEO + контент)"
        - text: "$45"
        - text: "$30"
        - text: "$18"
      - - text: "LTV / CAC"
        - text: "2,3x"
        - text: "3,6x"
        - text: "6,5x"
  - elementId: note
    elementType: text
    bounds: [60, 415, 840, 90]
    content:
      style: "$body"
      lineHeight: 1.55
      text: |
        <p>Подписка короткая по природе кейса (медиана детеншн-дела — 36 дней), поэтому экономика строится на <strong>разовой продаже Kit</strong> и на потоке: сотни тысяч новых кейсов в год, а не на удержании одного клиента годами.</p>
  - elementId: src
    elementType: text
    bounds: [60, 505, 840, 20]
    content: {style: "$small", text: "Полная формульная модель в Excel прилагается; сроки дел — медианы EOIR"}
